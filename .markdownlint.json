{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
  "default": true,
  "MD013": false,
  "MD036": false,
  "MD049": false,
  "MD028": false,
  "MD033": {
    "allowed_elements": ["br", "details", "summary", "sub", "sup", "kbd", "div", "img", "strong", "b"]
  },
  "MD024": { "siblings_only": true },
  "MD041": false,
  "MD046": { "style": "fenced" },
  "MD004": { "style": "dash" },
  "MD007": { "indent": 2 },
  "MD029": { "style": "ordered" }
}
