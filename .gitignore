# ---------------------------------------------------------------------------
# Secrets & credentials — NEVER commit these
# ---------------------------------------------------------------------------
*.env
.env
.env.*
!.env.example
*.tfvars
!*.tfvars.example
*.pem
*.key
*.crt
*.p12
*.pfx
credentials*.json
!credentials*.example.json
sa-key*.json
kubeconfig
*.kubeconfig
.kube/
secrets.yaml
!secrets.example.yaml
*-secret.yaml
!*-secret.example.yaml

# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---------------------------------------------------------------------------
