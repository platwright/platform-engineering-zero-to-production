# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing whitespace can be meaningful in Markdown (hard line breaks).
trim_trailing_whitespace = false
max_line_length = off

[*.{py,go}]
indent_size = 4

[Makefile]
indent_style = tab

[*.go]
indent_style = tab

[*.{tf,tfvars}]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2
